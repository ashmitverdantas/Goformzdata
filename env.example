# =============================================================================
# Local development template. Copy to ".env" and fill in REAL values.
# NEVER commit the real .env — it is excluded by .dockerignore / .gitignore.
# In Azure, these are injected as Container App env vars + secret references.
# =============================================================================

# --- GoFormz login ---
GOFORMZ_EMAIL=umella@verdantas.com
GOFORMZ_PASSWORD=

# --- Azure AI Document Intelligence (OCR) ---
AZURE_DI_ENDPOINT=https://vpc-dev-documentintelligence.cognitiveservices.azure.com/
AZURE_DI_KEY=
AZURE_DI_API_VERSION=2024-11-30
AZURE_DI_MODEL_ID=prebuilt-layout

# --- Fabric / OneLake (service principal) ---
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
FABRIC_WORKSPACE_NAME=vdt-dev-fbrc-wkspc
FABRIC_LAKEHOUSE_NAME=Ashmit_Test_Lakehouse
ONELAKE_TARGET_SUBPATH=Files/goformz

# --- Behaviour ---
# Empty START_DATE/END_DATE => completed previous Friday..Thursday cycle.
START_DATE=
END_DATE=
MAX_FORMS=500

# Set to false ONLY for local dev to allow saving to disk instead of OneLake.
REQUIRE_ONELAKE_UPLOAD=true

# --- Selenium / Chromium (set automatically inside the container) ---
HEADLESS=true
# CHROME_BIN=/usr/bin/chromium
# CHROMEDRIVER_PATH=/usr/bin/chromedriver
